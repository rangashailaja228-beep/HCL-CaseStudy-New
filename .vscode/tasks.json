{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Java Sources",
      "type": "shell",
      "command": "javac -d bin src/*.java",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Start Web UI Server",
      "type": "shell",
      "command": "java -cp bin src.WebServer --port 8088",
      "problemMatcher": []
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "java -cp bin src.TestRunner",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    }
  ]
}
